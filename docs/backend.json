
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Profil d'un membre du club",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "matricule": { "type": "string", "description": "Identifiant unique du membre" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "username": { "type": "string", "description": "Pseudo unique de l'élève au sein du studio" },
        "classe": { "type": "string", "description": "Classe de l'élève de la 6e à la Terminale" },
        "phone": { "type": "string" },
        "company": { "type": "string" },
        "interests": { "type": "array", "items": { "type": "string" }, "description": "Centres d'intérêt créatifs de l'élève" },
        "bio": { "type": "string", "description": "Biographie ou devise de créateur" },
        "links": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string" }
            }
          },
          "description": "Liens de redirection (réseaux sociaux, portfolio...)"
        },
        "onboarded": { "type": "boolean" },
        "deviceId": { "type": "string" },
        "online": { "type": "boolean" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "following": { "type": "array", "items": { "type": "string" }, "description": "Liste des UID des créateurs suivis" }
      },
      "required": ["uid", "matricule"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Données de profil utilisateur"
    }
  }
}
